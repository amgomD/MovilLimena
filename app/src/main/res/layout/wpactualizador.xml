<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
  >


    <LinearLayout
        android:id="@+id/contendorapi"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_button_cardalert"
        android:backgroundTint="@color/Blanco"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">
        <!-- Icono -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_notifications_black_24dp"
            android:tint="#2196F3" />

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Nueva versión"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Estado -->
        <TextView
            android:id="@+id/txtversion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.1.2 -> 1.1.4"
            android:textColor="#666666"
            android:textSize="14sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_button_card">

            <TextView
                android:id="@+id/txtnotas"
                android:layout_width="match_parent"

                android:layout_height="wrap_content"
                android:overScrollMode="always"
                android:padding="10dp"
                android:scrollbars="vertical"
                android:text="Notas"
                android:textColor="#666666"
                android:textSize="14sp" />

        </ScrollView>


        <!-- Botón (opcional) -->
        <Button
            android:id="@+id/btndescargar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_button_sinco"
            android:text="Actualizar"
            android:textColor="#FFFFFF" />
        <CheckBox
            android:id="@+id/ignorarmensaje"
            android:layout_marginTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No mostrar este mensaje"
            android:textColor="#666666"
            android:textSize="14sp"

            />
    </LinearLayout>

    <LinearLayout
        android:visibility="gone"
        android:id="@+id/contenedorinstalando"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bg_button_cardalert">
    <!-- Icono -->
    <ImageView
        android:id="@+id/imgEstado"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@android:drawable/stat_sys_download"
        android:tint="#2196F3"
        android:layout_marginBottom="16dp"/>

    <!-- Título -->
    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Actualizando aplicación"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="8dp"/>

    <!-- Estado -->
    <TextView
        android:id="@+id/txtEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Preparando..."
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="24dp"/>

    <!-- Barra progreso -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#2196F3"
        android:layout_marginBottom="8dp"/>

    <!-- Porcentaje -->
    <TextView
        android:id="@+id/txtProgreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0%"
        android:textSize="14sp"
        android:textColor="#000000"
        android:layout_marginBottom="24dp"/>

    <!-- Botón (opcional) -->
    <Button
        android:id="@+id/btnAccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancelar"
        android:background="@drawable/bg_button_sinco"
        android:backgroundTint="@color/Blanco"
        android:textColor="#2196F3"/>

</LinearLayout>

</LinearLayout>