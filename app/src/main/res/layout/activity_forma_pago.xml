                        android:layout_weight="1"
                        android:layout_width="match_parent"
                        android:textAlignment="center"
                        android:layout_height="wrap_content"
                        android:textSize="20dp"
                        android:background="@color/GrisBusqueda"
                        android:text="0"/>

