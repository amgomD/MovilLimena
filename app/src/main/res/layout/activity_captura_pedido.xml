<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CapturaPedido">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <ToggleButton
                    android:id="@+id/toggleResumen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textOff="Resumen"
                    android:textOn="Todo" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView18"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/GrisLetra"
                    android:lines="1"
                    android:padding="2dp"
                    android:text="Subtotal"
                    android:textColor="@color/Blanco"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_abonoori2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/Blanco"
                    android:lines="1"
                    android:padding="2dp"
                    android:text="Sub"
                    android:textColor="@color/GrisLetra"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/GrisLetra"
                    android:lines="1"
                    android:padding="2dp"
                    android:text="Iva"
                    android:textColor="@color/Blanco"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_abonoori"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/Blanco"
                    android:lines="1"
                    android:padding="2dp"
                    android:text="iva"
                    android:textColor="@color/GrisLetra"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView17"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/GrisLetra"
                    android:lines="1"
                    android:padding="2dp"
                    android:text="Impo."
                    android:textColor="@color/Blanco"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_retencion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/Blanco"
                    android:lines="1"
                    android:padding="2dp"
                    android:text="impo"
                    android:textColor="@color/GrisLetra"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView118"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/GrisLetra"
                    android:lines="1"
                    android:padding="2dp"
                    android:text="Total"
                    android:textColor="@color/Blanco"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_neto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/Blanco"
                    android:lines="1"
                    android:padding="2dp"
                    android:text="Total"
                    android:textColor="@color/GrisLetra"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <SearchView
                    android:id="@+id/search_codigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/GrisBorde"
                    android:focusable="false"
                    android:inputType="none|number">

                </SearchView>

                <SearchView
                    android:id="@+id/search_nombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/GrisBorde"
                    android:focusable="false">

                </SearchView>

            </LinearLayout>

            <ListView
                android:id="@+id/listview_productos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:focusable="false"
                android:descendantFocusability="beforeDescendants" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>