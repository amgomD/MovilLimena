<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/fondo"
    android:background="#14010101"
    tools:context=".ResumenPedido">


    <LinearLayout
        android:id="@+id/panel"
        android:padding="10dp"
        android:layout_width="300dp"

        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:clickable="true"
        android:focusable="true"
        android:background="@color/Blanco"
        android:orientation="vertical">

        <LinearLayout
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView18"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/GrisLetra"
                    android:lines="1"
                    android:padding="2dp"
                    android:text="Subtotal"
                    android:textColor="@color/Blanco"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_abonoori"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/Blanco"
                    android:lines="1"
                    android:padding="2dp"
                    android:text="Sub"
                    android:textColor="@color/GrisLetra"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:visibility="gone"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:visibility="gone"
                    android:background="@color/GrisLetra"
                    android:lines="1"
                    android:padding="2dp"
                    android:text="Iva"
                    android:textColor="@color/Blanco"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_retencion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/Blanco"
                    android:visibility="gone"
                    android:lines="1"
                    android:padding="2dp"
                    android:text="iva"
                    android:textColor="@color/GrisLetra"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView17"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/GrisLetra"
                    android:lines="1"
                    android:padding="2dp"
                    android:text="Impo."
                    android:textColor="@color/Blanco"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_retencionica"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/Blanco"
                    android:lines="1"
                    android:padding="2dp"
                    android:text="impo"
                    android:textColor="@color/GrisLetra"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView118"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/GrisLetra"
                    android:lines="1"
                    android:padding="2dp"
                    android:text="Total"
                    android:textColor="@color/Blanco"
                    android:textStyle="bold" />

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/Blanco"
                    android:lines="1"
                    android:padding="2dp"
                    android:text="Total"
                    android:textColor="@color/GrisLetra"
                    android:textStyle="bold" />

            </LinearLayout>
<Button
    android:id="@+id/importar"
    android:layout_width="match_parent"
    android:layout_height="50dp"
android:visibility="gone"
    android:layout_weight="1"
    android:drawableTop="@android:drawable/ic_menu_upload"
    android:textColor="@color/Blanco"
    android:backgroundTint="#8BC34A" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
            <SearchView
                android:id="@+id/search_nombre"
                android:background="@drawable/bg_button"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:layout_weight="0"></SearchView>
            <ListView
                android:id="@+id/listview_productos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:focusable="false"
                android:descendantFocusability="beforeDescendants" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_gravity="bottom"
                android:gravity="bottom"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="match_parent"
                    android:textAlignment="center"
                    android:background="#E91E63"
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:textSize="12dp"
                    android:padding="2dp"
                    android:textStyle="bold"
                    android:textColor="@color/Blanco"
                    android:text="TOTAL" />
                <TextView
                    android:id="@+id/creditomalo"
                    android:layout_width="match_parent"
                    android:textAlignment="textEnd"
                    android:background="#E91E63"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:padding="2dp"
                    android:gravity="center"
                    android:textSize="12dp"
                    android:textColor="@color/Blanco"
                    android:textStyle="bold"
                    android:text="0.00" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_gravity="bottom"
                android:gravity="bottom"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="match_parent"
                    android:textAlignment="center"
                    android:background="#009688"
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:textSize="12dp"
                    android:padding="2dp"
                    android:textStyle="bold"
                    android:textColor="@color/Blanco"
                    android:text="TOTAL" />
                <TextView
                    android:id="@+id/creditobueno"
                    android:layout_width="match_parent"
                    android:textAlignment="textEnd"
                    android:background="#009688"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:padding="2dp"
                    android:gravity="center"
                    android:textSize="12dp"
                    android:textColor="@color/Blanco"
                    android:textStyle="bold"
                    android:text="0.00" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:background="#021e36"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="TOTAL"
                    android:textAlignment="center"
                    android:textColor="@color/Blanco"
                    android:textSize="17dp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtTotal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:background="#021e36"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="0.00"
                    android:textAlignment="textEnd"
                    android:textColor="@color/Blanco"
                    android:textSize="17dp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txt_neto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:background="#021e36"
                    android:visibility="gone"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="0.00"
                    android:textAlignment="textEnd"
                    android:textColor="@color/Blanco"
                    android:textSize="17dp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>