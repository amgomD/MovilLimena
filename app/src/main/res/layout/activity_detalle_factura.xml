<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_height="wrap_content">
<TextView
    android:id="@+id/dFacNro"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="#0000"
    android:textColor="@color/Negro"
    android:textSize="25dp"
    />
        <View
            android:layout_width="match_parent"
            android:layout_height="15dp"
            />
<LinearLayout
    android:orientation="vertical"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha"
            android:lines="1"
            android:textAlignment="center"
            android:layout_margin="1dp"
            android:padding="5dp"
            android:background="#E4E4E4"
            android:textColor="@color/Negro"
            android:layout_weight="1"
            android:textSize="15dp"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lines="1"
            android:textAlignment="center"
            android:layout_margin="1dp"
            android:padding="5dp"
            android:background="#E4E4E4"
            android:text="Estado"
            android:textColor="@color/Negro"
            android:textSize="15dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subtotal"
            android:lines="1"
            android:textAlignment="center"
            android:layout_margin="1dp"
            android:padding="5dp"
            android:background="#E4E4E4"
            android:textColor="@color/Negro"
            android:layout_weight="1"
            android:textSize="15dp"
            />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
    <TextView
        android:id="@+id/FacFec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:text="Fecha"
        android:layout_weight="1"
        android:textSize="15dp"
        />

        <TextView
            android:id="@+id/FacEst"
            android:layout_width="match_parent"
            android:textAlignment="center"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Estado"
            android:textSize="15dp" />
        <TextView
            android:id="@+id/subtotal"
            android:layout_width="match_parent"
            android:textAlignment="center"
            android:layout_height="wrap_content"
            android:text="Subtotal"
            android:layout_weight="1"
            android:textSize="15dp"
            />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <TextView
            android:lines="1"
            android:layout_margin="1dp"
            android:padding="5dp"
            android:background="#E4E4E4"
            android:textAlignment="center"
            android:textColor="@color/Negro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="iva"
            android:layout_weight="1"
            android:textSize="15dp"
            />
        <TextView
            android:lines="1"
            android:layout_margin="1dp"
            android:padding="5dp"
            android:background="#E4E4E4"
            android:textAlignment="center"
            android:textColor="@color/Negro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total"
            android:layout_weight="1"
            android:textSize="15dp"
            />
        <TextView
            android:lines="1"
            android:layout_margin="1dp"
            android:padding="5dp"
            android:background="#E4E4E4"
            android:textAlignment="center"
            android:textColor="@color/Negro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Devolucion"
            android:layout_weight="1"
            android:textSize="15dp"
            />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <TextView
            android:id="@+id/iva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="iva"
            android:textAlignment="center"
            android:layout_weight="1"
            android:textSize="15dp"
            />
        <TextView
            android:id="@+id/Total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:text="Total"
            android:layout_weight="1"
            android:textSize="15dp"
            />
        <TextView
            android:id="@+id/Devolucion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:text="Devolucion"
            android:layout_weight="1"
            android:textSize="15dp"
            />
    </LinearLayout>


    <View
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:background="@color/GrisBorde"
        android:layout_height="2dp"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            android:layout_weight="2"
            android:textAlignment="center"
            android:lines="1"
            android:padding="5dp"
            android:text="Cod."
            android:background="#D1D1D1"
            android:textColor="@color/GrisLetra"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            android:layout_weight="1.1"

            android:lines="1"
            android:padding="5dp"
            android:text="Descripción"
            android:textAlignment="textStart"
            android:background="#D1D1D1"
            android:textColor="@color/GrisLetra"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            android:layout_weight="2"

            android:lines="1"
            android:padding="5dp"
            android:text="Uni."
            android:background="#D1D1D1"
            android:textAlignment="center"
            android:textColor="@color/GrisLetra"
            android:textStyle="bold" />



    </LinearLayout>

    <ListView
        android:id="@+id/Listadetalle"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>


    </LinearLayout>
</FrameLayout>