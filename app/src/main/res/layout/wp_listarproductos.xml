<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/contendorproducto"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/layoutfondo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:padding="5dp"
        android:background="@color/Blanco"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/imagenproducto"
            android:layout_width="100dp"
            android:layout_marginRight="10dp"
            android:layout_height="100dp"
            android:src="@mipmap/sinimagen"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txt_codigo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="1dp"

                        android:background="@color/Trasparente"
                        android:lines="1"
                        android:text="TextView"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/txt_nombre"
                        android:textColor="@color/Negro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/Trasparente"
                        android:text="TextView"
                        android:textSize="18sp"
                        android:textStyle="normal" />
                </LinearLayout>
                <ImageView
                    android:id="@+id/imgdcto"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:srcCompat="@mipmap/descuentoicon" />
                <ImageView
                    android:id="@+id/imgbono"
                    android:layout_width="30dp"
                    android:layout_height="40dp"
                    app:srcCompat="@mipmap/regaloicon" />
            </LinearLayout>


        </LinearLayout>

        <TextView
            android:id="@+id/txtCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/Trasparente"
            android:text="categoria"
            android:textSize="12sp"
            android:textStyle="bold" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/titulo115"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:background="@color/Trasparente"
                android:lines="1"
                android:padding="2dp"
                android:text="$"
                android:textColor="@color/GrisLetra"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_neto"
                android:layout_width="140dp"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:background="@color/Trasparente"
                android:lines="1"
                android:padding="2dp"
                android:text="Precio"
                android:textColor="@color/Negro"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/txt_Presentacion"
                android:layout_width="140dp"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:textAlignment="textEnd"
                android:background="@color/Trasparente"
                android:lines="1"
                android:padding="2dp"
                android:text="Precio"
                android:textColor="@color/Negro"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/txt_abonoori"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:layout_weight="2"
                android:background="@color/Trasparente"
                android:lines="1"
                android:padding="2dp"
                android:text="Precio Neto"
                android:textColor="@color/Color1"
                android:textSize="16sp"
                android:visibility="gone"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
    </LinearLayout>







        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/Trasparente"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="200dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_retencionica"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:background="@color/Trasparente"
                    android:padding="2dp"
                    android:text="Existencia"
                    android:textColor="@color/Color1"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_existencia"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:background="@color/Trasparente"
                    android:lines="1"
                    android:padding="2dp"
                    android:text="Existencia"
                    android:textColor="@color/Color1"
                    android:textSize="14sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/controles"
                android:layout_width="140dp"
                android:layout_height="match_parent"
                android:orientation="horizontal">


                <Button
                    android:id="@+id/btnrestar"
                    android:background="@drawable/bg_button_suma"

                    android:layout_width="30dp"
                    android:text="-"
                    android:textAlignment="center"
                    android:textSize="30sp"
                    android:textColor="@color/Blanco"
                    android:layout_height="40dp"/>

                <EditText
                    android:id="@+id/txtUnidades"
                    android:layout_weight="2"
                    android:layout_width="0dp"
                    android:textAlignment="center"
                    android:enabled="false"
                    android:text="0"
                    android:inputType="number"
                    android:textColor="#3F51B5"
                    android:textSize="20sp"
                    android:layout_height="wrap_content"/>
                <Button
                    android:id="@+id/btnsumar"
                    android:layout_width="30dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_button_resta"

                    android:text="+"
                    android:textAlignment="center"
                    android:textColor="@color/Blanco"
                    android:textSize="30sp" />






            </LinearLayout>


        </LinearLayout>
        <TextView
            android:id="@+id/Historialtext"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#e01d55"
            android:layout_marginBottom="10dp"
            android:textStyle="normal"
            android:text="" />

    </LinearLayout>
    <TextView
        android:id="@+id/txt_retencion"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_margin="1dp"
        android:background="@color/Trasparente"
        android:lines="1"
        android:padding="2dp"
        android:visibility="gone"
        android:text="Iva"
        android:textColor="@color/GrisLetra"
        android:textSize="14sp"
        android:textStyle="italic" />
</FrameLayout>