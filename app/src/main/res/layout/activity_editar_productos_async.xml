<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EditarProductoAsync">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="v2"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ToggleButton
                    android:id="@+id/toggleButton"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:lines="2"
                    android:text="ToggleButton"
                    android:textColor="@color/GrisLetra"
                    android:textOff="Teclado numerico Off"
                    android:textOn="Teclado Numerico ON"
                    android:textSize="10sp" />
            </LinearLayout>

            <SearchView
                android:id="@+id/search_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">

            </SearchView>

            <SearchView
                android:id="@+id/search_codigo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number">

            </SearchView>
        </LinearLayout>

        <ListView
            android:id="@+id/listview_productos"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

</FrameLayout>