<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#F4F6F8"
    tools:context=".visitacliente">

    <ScrollView
        android:layout_width="match_parent"
        android:padding="12dp"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
        >

            <!-- HEADER -->
            <TextView
                android:id="@+id/textView24"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pedido"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#222"
                android:gravity="start"
                android:layout_marginBottom="16dp"/>

            <!-- SECCION FORMULARIO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <!-- Causal -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Causal visita"
                    android:textStyle="bold"
                    android:textSize="13sp"/>

                <Spinner
                    android:id="@+id/spinner_causal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"/>

                <!-- Tipo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tipo documento"
                    android:textStyle="bold"
                    android:textSize="13sp"/>

                <Spinner
                    android:id="@+id/spinner_tipo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"/>

                <!-- Plazo -->
                <TextView
                    android:id="@+id/textviewplazo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Plazo"
                    android:textStyle="bold"
                    android:textSize="13sp"/>

                <Spinner
                    android:id="@+id/spinner_plazo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"/>

                <!-- Lista -->
                <TextView
                    android:id="@+id/textview204V2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lista de precio"
                    android:visibility="visible"

                    android:textStyle="bold"
                    android:textSize="13sp"/>
                <TextView
                    android:id="@+id/listapreciooo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/colorPrimary"
                    android:visibility="visible"
                    android:layout_marginBottom="10dp"
                    android:textStyle="bold"
                    android:textSize="13sp"/>
                <Spinner
                    android:id="@+id/spinner_lista"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"/>

                <!-- Bodega -->
                <TextView
                    android:id="@+id/txtBodega"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bodega"
                    android:textStyle="bold"
                    android:textSize="13sp"/>

                <Spinner
                    android:id="@+id/spinner_bodega"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <!-- SWITCHES -->
            <LinearLayout
                android:id="@+id/contPUente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/pun"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Plan puente"
                    android:textStyle="bold"/>

                <Switch
                    android:id="@+id/switch_planpuente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- OBSERVACION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/edit_observacion"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:hint="Observación"
                    android:gravity="top"
                    android:background="#F0F0F0"
                    android:padding="10dp"/>

                <Button
                    android:id="@+id/GuardarObs"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button_sinco"
                    android:backgroundTint="#00BCD4"
                    android:text="Guardar observación"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>




            <Button
                android:id="@+id/btn_cerrarvisita"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#9C27B0"
                android:text="Cerrar visita"
                android:textColor="#FFFFFF"
                android:visibility="gone"/>

        </LinearLayout>

    </ScrollView>

    <!-- BOTONES PRINCIPALES -->
    <Button
        android:id="@+id/btn_continuar"

        android:layout_width="match_parent"
        android:layout_gravity="bottom"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_button_sinco"
        android:text="Tomar Pedido / Nota"
        android:textColor="#FFFFFF"
        android:textStyle="bold"/>
    <Button
        android:id="@+id/btn_registrarvisita"
        android:layout_width="match_parent"
        android:layout_height="50dp"

        android:backgroundTint="#00BCD4"
        android:text="Registrar visita"
        android:textColor="#FFFFFF"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btn_ubicacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:backgroundTint="#ef9a9a"
        android:drawableLeft="@android:drawable/ic_menu_sort_by_size"
        android:text="Tomar Ubicacion"
        android:textColor="@color/Blanco"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="5dp"
            android:gravity="left"
            android:text="Viaje directo"
            android:textStyle="bold"
            android:visibility="visible" />

        <Switch
            android:id="@+id/switch_viajedir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|center_horizontal|center_vertical"
            android:layout_marginLeft="10dp"
            android:gravity="center|center_horizontal|center_vertical"
            android:textSize="18sp" />

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:visibility="gone"
        android:layout_weight="1"
        android:orientation="vertical"
        >
        <TextView
            android:visibility="gone"
            android:id="@+id/Cambiofotovis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="N"/>
        <ImageView

            android:id="@+id/MiFotoEnvio"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:src="@android:drawable/ic_menu_camera" />

        <Button
            android:id="@+id/btn_capturar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#98A3EE"
            android:drawableLeft="@android:drawable/ic_menu_camera"
            android:text="Capturar"
            android:textColor="@color/Blanco"
            android:textStyle="bold"
            android:visibility="visible" />

    </LinearLayout>
    <LinearLayout
        android:id="@+id/contenedorbarra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textColor="@color/Negro"
            android:text="Articulos actualizados"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            >
            <TextView
                android:id="@+id/numitems"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textSize="10dp"
                android:text="0"/>
            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textSize="10dp"
                android:text=" / "/>
            <TextView
                android:id="@+id/resfinal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textSize="10dp"
                android:text="0"/>

        </LinearLayout>

        <ProgressBar
            android:id="@+id/PrBar_NArticulos"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="50px"
            android:layout_weight="1" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_button_card"
            android:elevation="8dp">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Revisando bloqueos en la remisión"
                android:layout_marginTop="16dp"
                android:textSize="16sp"
                android:textColor="@android:color/black"/>
        </LinearLayout>

    </FrameLayout>
</FrameLayout>

