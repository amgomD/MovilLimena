<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ComportamientoVenta">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_resumenpedido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#8BC34A"
                android:drawableLeft="@android:drawable/ic_menu_myplaces"
                android:text="Resumen Pedido"
                android:textColor="@color/Blanco"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_tomarpedido2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#03A9F4"
                android:drawableLeft="@android:drawable/ic_menu_myplaces"
                android:text="Productos"
                android:textColor="@color/Blanco"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_tomarpedido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#98A3EE"
            android:drawableLeft="@android:drawable/ic_menu_myplaces"
            android:text="Tomar Pedido"
            android:textColor="@color/Blanco"
            android:textStyle="bold"
            android:visibility="gone" />


        <ListView
            android:id="@+id/listview_grupos"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

</FrameLayout>