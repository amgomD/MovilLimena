<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/SubNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SubGrupo"
            android:textAlignment="center"
            android:textColor="@color/Blanco"
            android:textStyle="bold"
            android:padding="2dp"
            android:background="#5689AA"
            android:textSize="17dp"
            />
        <TextView
            android:id="@+id/FamNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Familias"
            android:textAlignment="center"
            android:textColor="@color/Blanco"
            android:textStyle="bold"
            android:padding="2dp"
            android:background="#88ACC3"
            android:textSize="17dp"
            />
        <LinearLayout
            android:id="@+id/contenedor"
            android:padding="5dp"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/ArtCod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Codigo"
                android:textAlignment="center"
                android:textColor="@color/Negro"
                android:textStyle="normal"
                android:layout_marginRight="5dp"
                android:padding="2dp"

                android:textSize="17dp"
                />

            <TextView
                android:id="@+id/ArtNom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:text="Nombre"
                android:textAlignment="textEnd"
                android:textColor="@color/Negro"
                android:textSize="15dp"

                android:textStyle="bold" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
               android:layout_weight="1"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Exi: "
                    android:textAlignment="center"
                    android:textColor="@color/Negro"
                    android:textStyle="normal"
                    android:layout_marginRight="5dp"
                    android:padding="2dp"
                    android:textSize="17dp"
                    />
                <TextView
                    android:id="@+id/existencia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textAlignment="center"
                    android:textColor="@color/Negro"
                    android:textStyle="normal"
                    android:layout_marginRight="5dp"
                    android:padding="2dp"
                    android:textSize="17dp"
                    />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
               android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ean: "
                    android:textAlignment="center"
                    android:textColor="@color/Negro"
                    android:textStyle="normal"
                    android:layout_marginRight="5dp"
                    android:padding="2dp"
                    android:textSize="17dp"
                    />
                <TextView
                    android:id="@+id/Ean"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textAlignment="center"
                    android:textColor="@color/Negro"
                    android:textStyle="normal"
                    android:layout_marginRight="5dp"
                    android:padding="2dp"
                    android:textSize="17dp"
                    />

            </LinearLayout>


        </LinearLayout>
        </LinearLayout>
    </LinearLayout>



</FrameLayout>