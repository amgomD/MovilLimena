<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f0f4f7"

    tools:context=".Principal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="6dp"
        android:padding="3dp"
        android:orientation="vertical">

<LinearLayout
    android:layout_margin="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/VenCod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Codigo"
            android:fontFamily="sans-serif"
            android:textColor="@color/Negro"
            android:textStyle="normal"
            android:textSize="10sp"/>
        <TextView
            android:id="@+id/vendedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vendedor"
            android:fontFamily="sans-serif"
            android:textColor="@color/Negro"
            android:textStyle="normal"
            android:textSize="20dp"/>
        <TextView
            android:id="@+id/txt_ultsin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:textSize="10sp"
            android:text="Ultima sincronizacion" />
    </LinearLayout>
    <ImageView
        android:id="@+id/actualizcion"
        android:layout_width="100dp"
        android:layout_height="60dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:tint="#2196F3"
        app:srcCompat="@drawable/ic_notifications_black_24dp" />
    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        app:srcCompat="@mipmap/logomantis2" />


</LinearLayout>



        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="10dp">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">




    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="1"

        android:useDefaultMargins="true">

        <!-- 1 -->
        <Button
            android:id="@+id/btn_Sincronizar"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/bg_button"
            android:text="Sincronizar"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="#333333"
            android:gravity="center_vertical|start"
            android:padding="16dp"
            android:textAllCaps="false"
            android:drawableLeft="@android:drawable/ic_menu_rotate"
            android:drawablePadding="12dp"
            android:drawableTint="#0099ff"/>

        <!-- 2 -->
        <Button
            android:id="@+id/btn_clientespedido"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/bg_button"
            android:text="Ruta"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="#333333"
            android:gravity="center_vertical|start"
            android:padding="16dp"
            android:textAllCaps="false"
            android:drawableLeft="@android:drawable/ic_menu_myplaces"
            android:drawablePadding="12dp"
            android:drawableTint="#0099ff"/>

        <!-- 3 -->
        <Button
            android:id="@+id/btn_extraruta"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/bg_button"
            android:text="Extraruta"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textAllCaps="false"
            android:textColor="#333333"
            android:gravity="center_vertical|start"
            android:padding="16dp"
            android:drawableLeft="@android:drawable/ic_menu_myplaces"
            android:drawablePadding="12dp"
            android:drawableTint="#0099ff"/>

        <!-- 4 -->
        <Button
            android:id="@+id/btn_enviarpedidos"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/bg_button"
            android:text="Resumen Día"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="#333333"
            android:gravity="center_vertical|start"
            android:padding="16dp"
            android:drawableLeft="@android:drawable/ic_menu_upload"
            android:drawablePadding="12dp"
            android:drawableTint="#0099ff"/>

        <!-- 6 -->
        <Button
            android:id="@+id/btn_informediario"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/bg_button"
            android:text="Ventas por cliente"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textAllCaps="false"
            android:textColor="#333333"
            android:gravity="center_vertical|start"
            android:padding="16dp"
            android:drawableLeft="@android:drawable/ic_menu_my_calendar"
            android:drawablePadding="12dp"
            android:drawableTint="#0099ff"/>
        <Button
            android:id="@+id/revisionalistamiento"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/bg_button"
            android:text="Gestión de pedidos"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textAllCaps="false"
            android:textColor="#333333"
            android:gravity="center_vertical|start"
            android:padding="16dp"
            android:drawableLeft="@android:drawable/ic_menu_my_calendar"
            android:drawablePadding="12dp"
            android:drawableTint="#0099ff"/>
        <!-- 5 -->
        <Button
            android:id="@+id/btn_reset"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/bg_button_sinco"
            android:text="Configuraciones"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:gravity="center_vertical|start"
            android:padding="16dp"
            android:drawableLeft="@android:drawable/ic_menu_manage"
            android:drawablePadding="12dp"
            android:drawableTint="#FFFFFF"/>

        <Button
            android:id="@+id/btn_crearcliente"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/bg_button"
            android:text="Crear Clientes"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#333333"
            android:gravity="top|center"
            android:padding="16dp"
            android:drawableTop="@android:drawable/ic_menu_add"
            android:drawablePadding="12dp"
            android:drawableTint="#E0E2EB"/>
    </GridLayout>





    <TextView
        android:id="@+id/txt_versionapp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:text="Version 2025.02.28.1"
        android:textColor="#0099ff" />



    <TextView
        android:id="@+id/txt_fecser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:text="Fecha servidor" />

    <TextView
        android:id="@+id/txt_horenv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:text="Hora envio" />

    <TextView
        android:id="@+id/txt_pedmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:text="Pedido minimo" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btn_soporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_card"
            android:drawableLeft="@android:drawable/ic_menu_help"
            android:text="Soporte"
            android:textColor="@color/GrisLetra"/>
        <Button
            android:id="@+id/btn_actualizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="10dp"
            android:background="@drawable/bg_button_sinco"
            android:drawableLeft="@android:drawable/ic_menu_save"
            android:text="Actualizar BD"
            android:textColor="@color/Blanco"/>

    </LinearLayout>

</LinearLayout>
        </ScrollView>

    </LinearLayout>





    <View
        android:id="@+id/fondoOscuro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"/>
</FrameLayout>