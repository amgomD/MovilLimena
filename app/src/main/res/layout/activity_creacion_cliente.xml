<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    tools:context=".CreacionCliente">

    <Button
        android:id="@+id/btn_Escanear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="EscanerQR"
        android:text="Escanear"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/scrollView"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/textView25"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_margin="10dp"
                android:text="Registro Cliente"
                android:textSize="20dp" />

            <EditText
                android:id="@+id/Nit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="Nit/Cedula"
                android:inputType="number" />

            <EditText
                android:id="@+id/PriNom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Primer Nombre" />

            <EditText
                android:id="@+id/SegNom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Segundo Nombre" />

            <EditText
                android:id="@+id/PriApe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Primer Apellido" />

            <EditText
                android:id="@+id/SegApe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Segundo Apellido" />

            <EditText
                android:id="@+id/NombreEst"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:hint="Nombre Establecimiento" />

            <EditText
                android:id="@+id/Correo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Correo Electronico" />



            <EditText
                android:id="@+id/FecVis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:enabled="true"
                android:hint="Fecha de visita"
                android:inputType="date"
                android:visibility="gone" />
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <Spinner
        android:id="@+id/sDir"
        android:layout_weight="3"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <EditText
        android:id="@+id/dir1"
        android:layout_weight="1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Direccion" />
</LinearLayout>


            <Spinner
                android:id="@+id/spinner_movtipdir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView45"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  #   "
                    android:textSize="24dp"
                    android:visibility="invisible" />

                <EditText
                    android:id="@+id/dir2"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/textView46"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  -  "
                    android:textSize="24dp"
                    android:visibility="invisible" />

                <EditText
                    android:id="@+id/dir3"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:visibility="invisible" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/Ciudad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_weight="1"
                    android:editable="false"
                    android:enabled="false"
                    android:hint="Codigo" />

                <EditText
                    android:id="@+id/nomciudad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_weight="1"
                    android:editable="false"
                    android:enabled="false"
                    android:hint="Ciudad" />

                <Button
                    android:id="@+id/btnCiudad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#ef9a9a"
                    android:drawableRight="@android:drawable/ic_menu_search"
                    android:text="Buscar"
                    android:textColor="@color/Blanco" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/Barrio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:editable="false"
                    android:enabled="false"
                    android:hint="Codigo" />

                <EditText
                    android:id="@+id/nombarrio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:editable="false"
                    android:enabled="false"
                    android:hint="Barrio" />

                <Button
                    android:id="@+id/BtnBarrio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#ef9a9a"
                    android:drawableRight="@android:drawable/ic_menu_search"
                    android:text="Buscar"
                    android:textColor="@color/Blanco" />
            </LinearLayout>

            <EditText
                android:id="@+id/Telefono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:hint="Telefono" />

            <EditText
                android:id="@+id/Celuar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Celular" />
            <EditText
                android:id="@+id/Plazo"
                android:numeric="decimal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Plazo" />
            <TextView
                android:text="CUPO:"
                android:textSize="30px"
                android:padding="3dp"
                android:background="@color/GrisLetra"
                android:textColor="#FFFFFF"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/cupoText"
                android:text="0"
                android:textSize="50px"
                android:textColor="#E91E63"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/Cupocli"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Cupo"

                android:numeric="integer" />

            <LinearLayout
                android:layout_width="match_parent"
                android:id="@+id/contendorficc"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:background="@color/GrisBusqueda"
                        android:layout_width="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        >
                        <TextView
                            android:layout_width="match_parent"
                            android:background="@color/Blanco"
                            android:layout_height="wrap_content"
                            android:text="Perfil"/>
                        <Spinner
                            android:id="@+id/percli"
                            android:layout_marginTop="5dp"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:spinnerMode="dialog" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/GrisBusqueda"
                        android:layout_margin="5dp"
                        android:orientation="vertical"
                        >
                        <TextView
                            android:layout_width="match_parent"
                            android:background="@color/Blanco"
                            android:layout_height="wrap_content"
                            android:text="Tipo cliente"/>
                        <Spinner
                            android:id="@+id/tipocliente"
                            android:layout_marginTop="5dp"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:spinnerMode="dialog" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:background="@color/GrisBusqueda"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:background="@color/Blanco"

                            android:layout_height="wrap_content"
                            android:text="Lista precio"/>
                        <Spinner
                            android:id="@+id/listaprecio"
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:spinnerMode="dialog" />
                    </LinearLayout>

                    <LinearLayout
                        android:background="@color/GrisBusqueda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:orientation="vertical"
                        >
                        <TextView
                            android:layout_width="match_parent"
                            android:background="@color/Blanco"
                            android:layout_height="wrap_content"
                            android:text="Categoria"/>

                        <Spinner
                            android:id="@+id/categoria"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="5dp"
                            android:padding="10dp"
                            android:spinnerMode="dialog" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:background="@color/GrisBusqueda"
                    android:layout_margin="5dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:background="@color/Blanco"
                        android:layout_height="wrap_content"
                        android:text="Zona"/>
                    <Spinner
                        android:id="@+id/zona"
                        android:layout_marginTop="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:layout_gravity="center_horizontal"
                        android:spinnerMode="dialog" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"

                android:layout_height="wrap_content"
                android:text="Frecuencia" />

            <LinearLayout
                android:layout_width="match_parent"
                android:background="@color/GrisBusqueda"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Spinner
                    android:id="@+id/Frecuencia"
                    android:layout_marginTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:spinnerMode="dialog" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <ToggleButton
                    android:id="@+id/Lunes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:singleLine="false"
                    android:text="Lunes"
                    android:textOff="Lun"
                    android:textOn="Lun" />

                <ToggleButton
                    android:id="@+id/Martes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:singleLine="false"
                    android:text="Lunes"
                    android:textOff="Mar"
                    android:textOn="Mar" />

                <ToggleButton
                    android:id="@+id/Miercoles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:singleLine="false"
                    android:text="Lunes"
                    android:textOff="Mie"
                    android:textOn="Mie" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <ToggleButton
                    android:id="@+id/Jueves"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:singleLine="false"
                    android:text="Lunes"
                    android:textOff="Jue"
                    android:textOn="Jue" />

                <ToggleButton
                    android:id="@+id/Viernes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:singleLine="false"
                    android:text="Lunes"
                    android:textOff="Vie"
                    android:textOn="Vie" />

                <ToggleButton
                    android:id="@+id/Sabado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:singleLine="false"
                    android:text="Lunes"
                    android:textOff="Sab"
                    android:textOn="Sab" />

            </LinearLayout>

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" />

            <EditText
                android:id="@+id/Frecuencfia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ems="10"
                android:hint="Frecuencia"
                android:inputType="number"
                android:visibility="invisible" />







            <TextView
                android:layout_width="wrap_content"

                android:layout_height="wrap_content"
                android:text="Canal"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:background="@color/GrisBusqueda"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Spinner
                    android:id="@+id/Canal"
                    android:layout_marginTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:spinnerMode="dialog" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SubCanal"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/GrisBusqueda"
                android:orientation="vertical">
                <Spinner
                    android:id="@+id/Scanal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dialog"
                    android:textColor="@android:color/white" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tamaño"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/GrisBusqueda"
                android:orientation="vertical">
                <Spinner
                    android:id="@+id/Tamano"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/scrollView"
                    android:layout_centerHorizontal="true"
                    android:textColor="@android:color/white" />
            </LinearLayout>






            <EditText
                android:id="@+id/Observacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Observacion"
                android:lines="4"
                android:linksClickable="true" />
             <TextView
                 android:id="@+id/cambioimg"
                 android:layout_width="wrap_content"
                 android:layout_height="match_parent"
                 android:text="N"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/MiFotoEnvio"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:src="@android:drawable/ic_menu_camera" />
       <TextView
           android:text="..."
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:id="@+id/rutapath"/>
                <Button
                    android:id="@+id/Capturar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Camara" />

            </LinearLayout>

            <Button
                android:id="@+id/Guardar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:background="#1db3b3"
                android:backgroundTint="#ef9a9a"
                android:gravity="center_vertical|center|center_horizontal"
                android:padding="10dp"
                android:text="Guardar"


                />

            <EditText
                android:id="@+id/Nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="true"
                android:hint="Nombre Cliente"
                android:visibility="invisible" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>