<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="#59E3E3E3"
        android:padding="2dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
         android:background="@color/Blanco"
            android:gravity="center"
            android:orientation="horizontal">
            <LinearLayout
                android:background="@color/Blanco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/enviado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#E9FFD0"
                    android:text="Enviado"
                    android:padding="5dp"
                    android:textColor="#338536"
                    android:textSize="15dp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/recibido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#E91E63"
                    android:text="Recibido"
                    android:padding="5dp"
                    android:textColor="#FFFFFF"
                    android:textSize="15dp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/pendiente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="5dp"
                    android:background="#4BFFEB3B"
                    android:text="Pendiente"
                    android:textColor="#AA8927"
                    android:textSize="15dp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/ConNro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="REC20021144-18"
                    android:textStyle="bold"
                    android:textColor="#1267AA"
                    android:textSize="18dp" />


            </LinearLayout>

            <TextView
                android:id="@+id/Valorcon"
                android:layout_width="match_parent"

                android:layout_height="match_parent"
                android:layout_weight="2"
                android:gravity="center"
                android:text="$20000000"
                android:textAlignment="center"
                android:textColor="@color/Negro"
                android:textSize="20dp" />


        </LinearLayout>
        <LinearLayout
            android:background="@color/Blanco"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            >
            <TextView
                android:layout_width="wrap_content"
                android:textStyle="bold"
                android:textSize="14dp"
                android:layout_height="wrap_content"
                android:text="Valor fot:  "/>
            <TextView
                android:id="@+id/nroFotos"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:textSize="14dp"
                android:layout_height="wrap_content"
                android:text="Valor"/>
            <TextView
                android:layout_width="wrap_content"
                android:textStyle="bold"
                android:textSize="14dp"
                android:layout_height="wrap_content"
                android:text="N° rec:  "/>
            <TextView
                android:id="@+id/nroRec"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:textSize="14dp"
                android:layout_height="wrap_content"
                android:text="Valor"/>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enviar"
               android:id="@+id/enviarsolo"
                android:textAllCaps="false"
                android:backgroundTint="@color/Color1"
                android:textColor="@color/Blanco"/>
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver"
                android:id="@+id/ver"
                android:textAllCaps="false"
                android:backgroundTint="#1668AA"
                android:textColor="@color/Blanco"/>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
