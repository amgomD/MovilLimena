<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/framecompleto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp"
    tools:context=".ConsignacionEfectivo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="match_parent"

                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Consignar efectivo"
                android:textSize="28dp"
                android:layout_weight="1"
                android:textStyle="normal"
                android:textColor="@color/Negro"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Creación de la consignación."
                android:layout_weight="1"
                android:textSize="15dp"
                android:textColor="@color/GrisLetra"/>

            </LinearLayout>
            <Button
                android:id="@+id/nuevacon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15dp"
                android:text="Nuevo"
                android:visibility="gone"
                android:layout_marginTop="10dp"
                android:textAllCaps="false"
                android:textColor="@color/Blanco"
                android:backgroundTint="#1267AA"/>
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="15dp"
            android:background="@color/Blanco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="N°"
                android:layout_weight="1.1"
                android:textSize="15dp"
                android:textColor="@color/GrisLetra"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Año"
                android:layout_weight="1.02"
                android:textSize="15dp"
                android:textColor="@color/GrisLetra"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mes"
                android:layout_weight="1.1"

                android:textSize="15dp"
                android:textColor="@color/GrisLetra"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1.1"
                android:text="Día"
                android:textSize="15dp"
                android:textColor="@color/GrisLetra"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#54767676"
            android:orientation="horizontal"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1.1"
                android:layout_margin="1dp"
                android:background="@color/Blanco"
                android:orientation="horizontal"
                >

                <Spinner
                    android:id="@+id/prefijo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:layout_marginLeft="1dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginRight="1dp"
                    android:spinnerMode="dialog"
                    android:textAlignment="center"
                    android:visibility="visible" />


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1.02"
                android:layout_margin="1dp"
                android:background="@color/Blanco"
                android:orientation="horizontal"
                >
                <Spinner
                    android:id="@+id/ano"
                    android:layout_width="match_parent"
                    android:textAlignment="center"

                    android:layout_height="match_parent"
                    android:layout_marginLeft="1dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginRight="1dp"
                    android:spinnerMode="dialog"
                    android:visibility="visible" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1.1"
                android:layout_margin="1dp"
                android:background="@color/Blanco"
                android:orientation="horizontal"
                >
                <Spinner
                    android:id="@+id/mes"
                    android:layout_width="match_parent"
                    android:textAlignment="center"

                    android:layout_height="match_parent"
                    android:layout_marginLeft="1dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginRight="1dp"
                    android:spinnerMode="dialog"
                    android:visibility="visible" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1.1"
                android:layout_margin="1dp"
                android:background="@color/Blanco"
                android:orientation="horizontal"
                >
                <Spinner
                    android:id="@+id/dia"
                    android:layout_width="match_parent"
                    android:textAlignment="center"

                    android:layout_height="match_parent"
                    android:layout_marginLeft="1dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginRight="1dp"
                    android:spinnerMode="dialog"
                    android:visibility="visible" />

            </LinearLayout>
        </LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/info"
    android:orientation="vertical">



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginTop="5dp"
            android:layout_height="wrap_content"
            android:background="@color/Blanco"
            android:orientation="horizontal"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Observación"
                android:layout_weight="1"
                android:textSize="15dp"
                android:textColor="@color/GrisLetra"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Valor"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_weight="1"
                android:textSize="15dp"
                android:textColor="@color/GrisLetra"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginTop="5dp"
            android:layout_height="wrap_content"
            android:background="@color/Blanco"
            android:orientation="horizontal"
            >
          <EditText
              android:id="@+id/observacion"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="text|textMultiLine"
              android:gravity="top"
              android:textSize="15dp"
              android:hint="Escribe una observación..."
              android:layout_weight="1"/>
            <TextView
                android:id="@+id/valorcon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_weight="1"
                android:textSize="25dp"
                android:textColor="@color/Negro"/>
        </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/Blanco"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@color/GrisBusqueda"
            android:gravity="center"
            android:padding="5px"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="3dp"
                android:textStyle="bold"
                android:layout_weight="1"
                android:gravity="end"
                android:background="@color/Blanco"
                android:textColor="#0A9510"
                android:id="@+id/tituloprove"
                android:text="Entrega Proveedor"/>

            <Switch
                android:id="@+id/Proveedor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:theme="@style/SCBSwitch" />
            />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/contproveedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="3dp"
                android:textColor="@color/Blanco"
                android:background="#4CAF50"
                android:text="Proveedor"/>
            <Spinner

                android:id="@+id/spproveedor"
                android:layout_width="match_parent"
                android:textAlignment="textStart"
                android:layout_height="match_parent"
                android:layout_marginLeft="1dp"
                android:layout_marginTop="1dp"
                android:layout_marginRight="1dp"
                android:spinnerMode="dialog"
                android:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/contcuentaproveedor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="3dp"
            android:textColor="@color/Blanco"
            android:background="#4CAF50"
            android:text="Cuenta proveedor"/>
        <Spinner

            android:id="@+id/sepcuentaprov"
            android:layout_width="match_parent"
            android:textAlignment="textStart"
            android:layout_height="match_parent"
            android:layout_marginLeft="1dp"
            android:layout_marginTop="1dp"
            android:layout_marginRight="1dp"
            android:spinnerMode="dialog"
            android:visibility="visible" />
    </LinearLayout>
</LinearLayout>


        <Button
            android:id="@+id/cargarrecibo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15dp"
            android:text="Aregar recibos"
            android:layout_marginTop="10dp"
            android:textAllCaps="false"
            android:drawableLeft="@android:drawable/ic_menu_add"
            android:textColor="@color/Blanco"
            android:backgroundTint="@color/Color1"/>
        <Button
            android:id="@+id/guardarcons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15dp"
            android:visibility="gone"
            android:text="Confirmar (0)"
            android:layout_marginTop="10dp"
            android:textAllCaps="false"
            android:drawableLeft="@android:drawable/ic_menu_send"
            android:textColor="@color/Blanco"
            android:backgroundTint="#AE46B808"/>
        <Button
            android:id="@+id/editarcons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15dp"
            android:text="Editar consignación"
            android:layout_marginTop="10dp"
            android:textAllCaps="false"
            android:drawableLeft="@android:drawable/ic_menu_edit"
            android:textColor="@color/Blanco"
            android:backgroundTint="#E91E63"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp"
            android:background="#59767676"/>
        <TextView
            android:id="@+id/ConNro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ConNro"/>
        <ListView
            android:id="@+id/ListarEfectivo"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>


</FrameLayout>