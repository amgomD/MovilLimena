<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="@drawable/bg_button_card"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/GrisBorde"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ArtCod"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:textAlignment="center"
                android:layout_weight="2"
                android:background="#009688"


                android:padding="5dp"
                android:text="ArtCod"
                android:textColor="@color/Blanco" />

            <TextView
                android:id="@+id/ArtNom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="textStart"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:background="@color/Blanco"

                android:padding="5dp"
                android:text="ArtNom"
                android:textColor="@color/GrisLetra" />



                <TextView
                    android:id="@+id/karuni"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:textAlignment="center"
                    android:layout_margin="1dp"
                    android:layout_weight="2"
                    android:background="@color/Blanco"

                    android:padding="5dp"
                    android:text="karuni"
                    android:textColor="@color/GrisLetra" />




        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#142196F3"
            android:orientation="horizontal"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Precio:"
                />

            <TextView
                android:id="@+id/KarPrePub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="1dp"
                android:textAlignment="textStart"
                android:layout_weight="1"
                android:background="@color/Blanco"

                android:padding="5dp"
                android:text="Precio"
                android:textColor="@color/GrisLetra" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dcto:"
                />

            <TextView
                android:id="@+id/KarDes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="1dp"
                android:textAlignment="textStart"
                android:layout_weight="1"
                android:background="@color/Blanco"

                android:padding="5dp"
                android:text="decto"
                android:textColor="@color/GrisLetra" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Valor:"
                />

            <TextView
                android:id="@+id/karvalor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="1dp"
                android:textAlignment="textStart"
                android:layout_weight="1"
                android:background="@color/Blanco"

                android:padding="5dp"
                android:text="Valor"
                android:textColor="@color/GrisLetra" />
            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Iva:"
                />
            <TextView
                android:id="@+id/KarArtIva"
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5"
                android:padding="5dp"
                android:background="@color/Blanco"
                />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>