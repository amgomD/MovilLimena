<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp">

        <!-- FILA 1: PEDIDO + ESTADOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNumeroPedido"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pedido #100245"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAlistado"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:gravity="center"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"

                android:text="ALISTADO"
                android:textColor="#166534"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmpacado"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"

                android:text="EMPACADO"
                android:textColor="#1E40AF"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvPendiente"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"

                android:text="PENDIENTE"
                android:textColor="#BC9009"
                android:textSize="9sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- FILA 2: CLIENTE + FECHA CREACIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCliente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="900123456"
                    android:textColor="#E91E63"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvRuta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="CLIENTE"
                    android:textColor="#374151"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvFechaCreacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="07/09/2026 08:32"
                android:textColor="#9CA3AF"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- FILA 3: FECHA ACTUAL + NUEVA FECHA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- FECHA ACTUAL -->
            <LinearLayout
                android:layout_width="0dp"
                android:visibility="visible"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alistamiento"
                    android:textColor="#2196F3"
                    android:visibility="gone"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvFechaAlistamiento"
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:gravity="center_vertical"
                    android:text="07/09/2026"
                    android:textColor="#374151"
                    android:visibility="gone"

                    android:textSize="15sp" />

            </LinearLayout>

            <!-- NUEVA FECHA -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"

                android:background="@drawable/bg_dialog_cargando"
                android:backgroundTint="#89EFEBEB"
                android:orientation="horizontal"
                android:gravity="center_vertical">


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="34dp"

                        android:gravity="center_vertical"
                        android:paddingStart="8dp"

                        android:text="Fecha Promesa de Entrega: "
                        android:textColor="#232D64"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvNuevaFecha"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"

                        android:text="Nueva fecha"
                        android:textColor="#E91E63"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnNuevaFecha"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_dialog_cargando"
                    android:backgroundTint="#055494"
                  android:contentDescription="Seleccionar fecha"
                    android:src="@android:drawable/ic_menu_my_calendar" />

                <Button
                    android:id="@+id/btnGuardarFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:minWidth="0dp"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:background="@drawable/bg_dialog_cargando"
                    android:backgroundTint="@color/Color1"
                    android:textColor="@color/Blanco"
                    android:text="GUARDAR"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- SEPARADOR -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E7EB" />

</LinearLayout>
