<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/framecompleto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Cartera">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/Blanco"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <Button
                android:id="@+id/Imprimir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#03A9F4"
                android:drawableLeft="@android:drawable/ic_input_get"
                android:enabled="true"
                android:text="Imprimir"
                android:textColor="@color/Blanco"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/finrecibo"
                        android:layout_width="match_parent"
                        android:layout_height="80px"
                        android:layout_margin="5dp"
                        android:layout_weight="2"
                        android:background="#2196F3"
                        android:gravity="center"
                        android:text="Finalizar recibo"
                        android:textAlignment="center"
                        android:textColor="@color/Blanco"
                        android:textSize="30px" />
                    <Button
                        android:id="@+id/enviarcorreo"
                        android:layout_width="match_parent"
                        android:layout_height="80px"
                        android:layout_margin="5dp"
                        android:layout_weight="2"
                        android:background="#3F51B5"
                        android:gravity="center"
                        android:text="Enviar correo"
                        android:textAlignment="center"
                        android:textColor="@color/Blanco"
                        android:textSize="30px" />

                </LinearLayout>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/Amarillocajas"
                    android:textAlignment="center"
                    android:padding="5dp"
                    android:text="Cartera"
                    android:layout_margin="2dp"
                    android:textColor="@color/GrisLetra"
                    android:textStyle="bold"
                    android:visibility="visible" />
                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/Amarillocajas"
                    android:padding="5dp"
                    android:textAlignment="center"
                    android:layout_margin="2dp"
                    android:text="Tot Pagos"
                    android:textColor="@color/GrisLetra"
                    android:textStyle="bold"
                    android:visibility="visible" />
                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/Amarillocajas"
                    android:padding="5dp"
                    android:textAlignment="center"
                    android:layout_margin="2dp"
                    android:text="Total Rete"
                    android:textColor="@color/GrisLetra"
                    android:textStyle="bold"
                    android:visibility="visible" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/txt_carteragen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/Blanco"
                    android:textAlignment="center"
                    android:layout_margin="2dp"
                    android:text="TextView"
                    android:visibility="visible" />
                <TextView
                    android:id="@+id/txt_carteraabonada"
                    android:layout_margin="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/Blanco"
                    android:text="TextView"
                    android:textAlignment="center"
                    android:textColor="#E91E63"
                    android:visibility="visible" />
                <TextView
                    android:id="@+id/totalrete"
                    android:layout_margin="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/Blanco"
                    android:text="TextView"
                    android:textAlignment="center"
                    android:visibility="visible" />

            </LinearLayout>
            </LinearLayout>

        </LinearLayout>




        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/Amarillocajas"
                android:textAlignment="center"
                android:padding="5dp"
                android:text="Total ReteIca"
                android:layout_margin="2dp"
                android:textColor="@color/GrisLetra"
                android:textStyle="bold"
                android:visibility="visible" />
            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/Amarillocajas"
                android:padding="5dp"
                android:textAlignment="center"
                android:layout_margin="2dp"
                android:text="Total ReteIva"
                android:textColor="@color/GrisLetra"
                android:textStyle="bold"
                android:visibility="visible" />
            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/Amarillocajas"
                android:padding="5dp"
                android:textAlignment="center"
                android:layout_margin="2dp"
                android:text="Total Dcto Fin"
                android:textColor="@color/GrisLetra"
                android:textStyle="bold"
                android:visibility="visible" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/totalreteica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/Blanco"
                android:textAlignment="center"
                android:layout_margin="2dp"
                android:text="TextView"
                android:visibility="visible" />
            <TextView
                android:id="@+id/totalreteiva"
                android:layout_margin="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/Blanco"
                android:text="TextView"
                android:textAlignment="center"
                android:visibility="visible" />
            <TextView
                android:id="@+id/totaldctofin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
android:textAlignment="center"

                android:text="Total abonos"
                android:background="@color/Blanco"
                android:textColor="@color/GrisLetra"
                android:layout_margin="2dp"
                android:visibility="visible" />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/Amarillocajas"
                android:textAlignment="center"
                android:padding="5dp"
                android:text="Total Dcto conf"
                android:layout_margin="2dp"
                android:textColor="@color/GrisLetra"
                android:textStyle="bold"
                android:visibility="visible" />
            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/Amarillocajas"
                android:padding="5dp"
                android:textAlignment="center"
                android:layout_margin="2dp"
                android:text="Total Dcto Prov"
                android:textColor="@color/GrisLetra"
                android:textStyle="bold"
                android:visibility="visible" />
            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/Amarillocajas"
                android:padding="5dp"
                android:textAlignment="center"
                android:layout_margin="2dp"
                android:text="Tot Dcto No oto "
                android:textColor="@color/GrisLetra"
                android:textStyle="bold"
                android:visibility="visible" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/totaldctoconf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/Blanco"
                android:textAlignment="center"
                android:layout_margin="2dp"
                android:text="TextView"
                android:visibility="visible" />
            <TextView
                android:id="@+id/totaldctoprov"
                android:layout_margin="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/Blanco"
                android:text="TextView"
                android:textAlignment="center"
                android:visibility="visible" />

            <TextView
                android:id="@+id/totaldctonoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@color/Blanco"
                android:text="Total abonos"
                android:textAlignment="center"
                android:textColor="@color/GrisLetra"
                android:visibility="visible" />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >

            <Button
                android:id="@+id/formapago"
                android:layout_width="match_parent"
                android:layout_height="80px"
                android:text="$ Forma pagos"
                android:layout_weight="2"
                android:layout_margin="5dp"
                android:textAlignment="center"
                android:gravity="center"
                android:background="#4CAF50"
                android:textSize="30px"
                android:textColor="@color/Blanco"
                />
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="horizontal"
  >

            <Button
                android:id="@+id/Pagartodo"
                android:layout_width="match_parent"
                android:layout_height="80px"
                android:text="Pagar Todo (0)"
                android:layout_weight="1"
                android:textSize="30px"
                android:layout_margin="5dp"

                android:textAlignment="center"
                android:gravity="center"
                android:background="#2196F3"
                android:textColor="@color/Blanco"
                />
    <CheckBox
        android:id="@+id/seltodos"
        android:layout_weight="2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Todos"
        android:layout_margin="5dp"
        />
</LinearLayout>
        </LinearLayout>
<View
    android:layout_width="match_parent"
    android:layout_height="2dp"
    android:layout_margin="10dp"
    android:background="@color/GrisBorde"
    />
        <ListView
            android:id="@+id/ListViewAbono"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

</FrameLayout>